                    <button
                      className="btn bg-transparent border-none rounded-lg hover:text-red-600 gap-2 text-white"
                      onClick={logout}
                    >
                      Logout <TbLogout className="text-error" />
                    </button>
                  </li>
                </ul>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  );
};

export default Navbar;

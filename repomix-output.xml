  --radius-field: 0.8rem;
  --radius-box: 1rem;
  --border: 1px;
}

/* --- LIGHT THEME (Soft Paper) --- */
@plugin "daisyui/theme" {
  name: "light";
  default: false;
  prefersdark: false;
  color-scheme: "light";
  /* UPDATED: Softer Off-White instead of blinding pure white */
  --color-base-100: #FAF9F6; 
  
  /* UPDATED: Slightly deeper gray for cards to stand out */
  --color-base-200: #E4E4E7; 
  
  --color-base-300: #D4D4D8;
  --color-base-content: #18181B; 
  --color-primary: oklch(55% 0.25 280); 
  --color-primary-content: #FFFFFF;
  --color-secondary: oklch(60% 0.1 280);
  --color-accent: oklch(55% 0.2 320);
  --color-error: oklch(60% 0.2 25);
  --radius-selector: 2rem;
  --radius-field: 0.8rem;
  --radius-box: 1rem;
  --border: 1px;
}

@layer utilities {
  .glass-panel {
    @apply bg-base-200/40 backdrop-blur-xl border border-base-content/5 shadow-2xl;
  }
  
  .glass-card {
    /* Adaptive glass */
    @apply bg-base-200/50 backdrop-blur-md border border-base-content/5 transition-all duration-300;
  }
  
  .glass-card:hover {
    @apply bg-base-200/80 border-primary/30 shadow-lg shadow-primary/10 -translate-y-1;
  }
  
  .bg-mesh {
    background-color: var(--color-base-100);
    background-image: 
      radial-gradient(at 0% 0%, color-mix(in oklab, var(--color-primary), transparent 90%) 0px, transparent 50%),
      radial-gradient(at 100% 0%, color-mix(in oklab, var(--color-secondary), transparent 90%) 0px, transparent 50%);
  }
}

@layer base {
  /* Scrollbar Track */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  /* Track Background */
  ::-webkit-scrollbar-track {
    background: var(--color-base-100); 
  }

  /* Handle (The moving part) */
  ::-webkit-scrollbar-thumb {
    background: var(--color-base-300);
    border-radius: 4px;
  }

  /* Handle on Hover */
  ::-webkit-scrollbar-thumb:hover {
    background: var(--color-primary); 
  }
}
